        <section id="dejar-resena" class="seccion_reseña">
            <div class="cont_reseñas_usuario" id="resenasUsuario">
                <h3 class="titulo_reseñas_usuario">Deja tu opinión</h3>
                <form class="form_reseña" id="formResena">
                    <div class="form_group_reseña">
                        <label for="nombre_reseña" class="form_label_reseña">
                            <i class="bi bi-person-fill"></i>
                            Tu nombre *
                        </label>
                        <input type="text" id="nombre_reseña" name="nombre_reseña" class="form_input_reseña" required placeholder="Ej. Juan Pérez">
                    </div>
                    <div class="form_group_reseña">
                        <label class="form_label_reseña">
                            <i class="bi bi-star-fill"></i>
                            Tu calificación *
                        </label>
                        <div class="estrellas_input" role="radiogroup" aria-label="Calificación de 1 a 5 estrellas">
                            <input type="radio" id="estrella_1" name="calificacion" value="1" required>
                            <label for="estrella_1" class="estrella_label" title="1 estrella"><i class="bi bi-star-fill"></i></label>
                            <input type="radio" id="estrella_2" name="calificacion" value="2">
                            <label for="estrella_2" class="estrella_label" title="2 estrellas"><i class="bi bi-star-fill"></i></label>
                            <input type="radio" id="estrella_3" name="calificacion" value="3">
                            <label for="estrella_3" class="estrella_label" title="3 estrellas"><i class="bi bi-star-fill"></i></label>
                            <input type="radio" id="estrella_4" name="calificacion" value="4">
                            <label for="estrella_4" class="estrella_label" title="4 estrellas"><i class="bi bi-star-fill"></i></label>
                            <input type="radio" id="estrella_5" name="calificacion" value="5">
                            <label for="estrella_5" class="estrella_label" title="5 estrellas"><i class="bi bi-star-fill"></i></label>
                        </div>
                    </div>
                    <div class="form_group_reseña">
                        <label for="comentario_reseña" class="form_label_reseña">
                            <i class="bi bi-chat-fill"></i>
                            Tu comentario *
                        </label>
                        <textarea id="comentario_reseña" name="comentario_reseña" class="form_textarea_reseña" required placeholder="Cuéntanos tu experiencia..." rows="4"></textarea>
                    </div>
                    <button type="submit" class="btn_enviar_reseña">Enviar reseña</button>
                </form>
                <div class="lista_reseñas_usuario" id="listaResenasUsuario">
                    <h4 class="subtitulo_reseñas">Reseñas de clientes</h4>
                    <ul class="cont_reseñas_lista" id="contResenasLista"></ul>
                </div>
            </div>
        </section>



        <!-- ///////////////////////////SECCION FOOTER//////////////// -->
        <section id="footer">
            <div class="cont_footer">

                <div class="sub_cont_footer">
                    <!-- Formulario de Contacto -->
                    <div class="cont_formulario_footer" id="reserva">
                        <div class="formulario_header">
                            <h1 class="titulo_formulario">¡Solicita tu Presupuesto Gratuito!</h1>
                            <p class="subtitulo_formulario">Completa el formulario y recibe una propuesta personalizada
                                en menos de 24 horas</p>
                        </div>

                        <form class="formulario_contacto" id="formularioContacto">
                            <div class="form_row">
                                <div class="form_group">
                                    <label for="nombre" class="form_label">
                                        <i class="bi bi-person-fill"></i>
                                        Nombre Completo *
                                    </label>
                                    <input type="text" id="nombre" name="nombre" class="form_input" required>
                                    <div class="form_validation"></div>
                                </div>

                                <div class="form_group">
                                    <label for="telefono" class="form_label">
                                        <i class="bi bi-telephone-fill"></i>
                                        Teléfono *
                                    </label>
                                    <input type="tel" id="telefono" name="telefono" class="form_input" required>
                                    <div class="form_validation"></div>
                                </div>
                            </div>

                            <div class="form_row">
                                <div class="form_group">
                                    <label for="email" class="form_label">
                                        <i class="bi bi-envelope-fill"></i>
                                        Correo Electrónico *
                                    </label>
                                    <input type="email" id="email" name="email" class="form_input" required>
                                    <div class="form_validation"></div>
                                </div>

                                <div class="form_group">
                                    <label for="ciudad" class="form_label">
                                        <i class="bi bi-geo-alt-fill"></i>
                                        Ciudad *
                                    </label>
                                    <input type="text" id="ciudad" name="ciudad" class="form_input" required>
                                    <div class="form_validation"></div>
                                </div>
                            </div>

                            <div class="form_row">
                                <div class="form_group form_group_full">
                                    <label for="tipo_proyecto" class="form_label">
                                        <i class="bi bi-house-gear-fill"></i>
                                        Tipo de Proyecto *
                                    </label>
                                    <select id="tipo_proyecto" name="tipo_proyecto" class="form_select" required>
                                        <option value="">Selecciona el tipo de proyecto</option>
                                        <option value="remodelacion_cocina">Remodelación de Cocina</option>
                                        <option value="remodelacion_bano">Remodelación de Baño</option>
                                        <option value="remodelacion_sala">Remodelación de Sala</option>
                                        <option value="remodelacion_completa">Remodelación Completa</option>
                                        <option value="terminaciones">Terminaciones</option>
                                        <option value="electricidad">Electricidad y Datos</option>
                                        <option value="plomeria">Plomería</option>
                                        <option value="mantenimiento">Mantenimiento</option>
                                        <option value="otro">Otro</option>
                                    </select>
                                    <div class="form_validation"></div>
                                </div>
                            </div>

                            <div class="form_row">
                                <div class="form_group">
                                    <label for="presupuesto" class="form_label">
                                        <i class="bi bi-currency-dollar"></i>
                                        Presupuesto Estimado
                                    </label>
                                    <select id="presupuesto" name="presupuesto" class="form_select">
                                        <option value="">Selecciona tu presupuesto</option>
                                        <option value="2-5">$2.000.000 - $5.000.000</option>
                                        <option value="5-10">$5.000.000 - $10.000.000</option>
                                        <option value="10-20">$10.000.000 - $20.000.000</option>
                                        <option value="20-50">$20.000.000 - $50.000.000</option>
                                        <option value="50+">Más de $50.000.000</option>
                                        <option value="consultar">Necesito asesoría</option>
                                    </select>
                                </div>

                                <div class="form_group">
                                    <label for="tiempo_proyecto" class="form_label">
                                        <i class="bi bi-calendar-event"></i>
                                        Tiempo de Ejecución Deseado
                                    </label>
                                    <select id="tiempo_proyecto" name="tiempo_proyecto" class="form_select">
                                        <option value="">Selecciona el tiempo</option>
                                        <option value="inmediato">Inmediato</option>
                                        <option value="1-2_semanas">1-2 semanas</option>
                                        <option value="1_mes">1 mes</option>
                                        <option value="2-3_meses">2-3 meses</option>
                                        <option value="mas_tiempo">Más tiempo</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form_row">
                                <div class="form_group form_group_full">
                                    <label for="descripcion" class="form_label">
                                        <i class="bi bi-chat-text-fill"></i>
                                        Descripción del Proyecto
                                    </label>
                                    <textarea id="descripcion" name="descripcion" class="form_textarea"
                                        placeholder="Cuéntanos más sobre tu proyecto, ideas, necesidades específicas..."></textarea>
                                    <div class="form_validation"></div>
                                </div>
                            </div>

                            <div class="form_row">
                                <div class="form_group form_group_full">
                                    <label class="form_label">
                                        <i class="bi bi-bell-fill"></i>
                                        ¿Cómo te gustaría que te contactemos?
                                    </label>
                                    <div class="form_checkbox_group">
                                        <label class="form_checkbox">
                                            <input type="checkbox" name="contacto_whatsapp" value="whatsapp">
                                            <span class="checkmark"></span>
                                            <i class="bi bi-whatsapp"></i>
                                            WhatsApp
                                        </label>
                                        <label class="form_checkbox">
                                            <input type="checkbox" name="contacto_llamada" value="llamada">
                                            <span class="checkmark"></span>
                                            <i class="bi bi-telephone"></i>
                                            Llamada
                                        </label>
                                        <label class="form_checkbox">
                                            <input type="checkbox" name="contacto_email" value="email">
                                            <span class="checkmark"></span>
                                            <i class="bi bi-envelope"></i>
                                            Email
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="form_row">
                                <div class="form_group form_group_full">
                                    <label class="form_checkbox form_checkbox_terms">
                                        <input type="checkbox" name="acepto_terminos" required>
                                        <span class="checkmark"></span>
                                        Acepto que M&amp;O Remodelaciones y Acabados me contacte para ofrecer sus servicios y que mis datos sean
                                        tratados según la política de privacidad *
                                    </label>
                                </div>
                            </div>

                            <div class="form_actions">
                                <button type="submit" class="btn_enviar_formulario">
                                    <i class="bi bi-send-fill"></i>
                                    <span>Enviar Solicitud</span>
                                    <div class="btn_loading">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </div>
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Información de Contacto -->
                    <div class="cont_info_contacto">
                        <div class="info_header">
                            <h1 class="titulo_footer">¡Conéctate con M&amp;O Remodelaciones y Acabados!</h1>
                            <h2 class="slogan_footer">¡No dudes en contactarnos para transformar tu espacio en el hogar
