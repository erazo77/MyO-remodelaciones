                                    <a href="mailto:contacto@myo-remodelaciones.com">contacto@myo-remodelaciones.com</a>
                                </li>
                            </ul>
                            <div class="redes_sociales_footer">
                                <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="btn_red_social" aria-label="Facebook">
                                    <i class="bi bi-facebook"></i>
                                </a>
                                <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="btn_red_social" aria-label="Instagram">
